PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Cloud: Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dashboard -> Project Settings -> API Keys -> Secret key
# Backend only. Never expose this key in frontend code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Dashboard -> Project Settings -> API Keys -> Publishable/anon key
# Dùng cho các thao tác đăng nhập và đăng ký qua Supabase Auth.
SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Blockchain (bắt buộc đủ 3 biến mới kết nối được; thiếu sẽ chạy Mock data)
# Khi dùng node hardhat trong docker (service "chain" trong compose.yml): http://chain:8545
# Khi chạy `npx hardhat node` trên máy host và backend ngoài Docker: http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
